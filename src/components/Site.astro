---
import { ui } from '../i18n/ui.js';
import { auditUi } from '../i18n/audit.js';
import { SHEET_ENDPOINT, FALLBACK_EMAIL } from '../config.js';
const { lang } = Astro.props;
const t = ui[lang];
// The contact form reuses the audit form's already-translated status strings
// (sending / confirmation / error) rather than introducing new copy.
const at = auditUi[lang];
const stats = {
  en: {
    proof: [
      { count: 15, suffix: ' yrs', label: t['proof.l1'] },
      { count: 50, prefix: '$', suffix: 'M+', label: t['proof.l2'] },
      { count: 300, prefix: '$', suffix: 'M+', label: t['proof.l3'] },
      { count: 30, suffix: '+', label: t['proof.l4'] },
    ],
    market: { count: 5.5, decimals: 1, prefix: '$', suffix: 'B' },
  },
  es: {
    proof: [
      { count: 15, suffix: ' años', label: t['proof.l1'] },
      { count: 50, lead: 'Más de ', prefix: '$', suffix: 'M', label: t['proof.l2'] },
      { count: 300, lead: 'Más de ', prefix: '$', suffix: 'M', label: t['proof.l3'] },
      { count: 30, lead: 'Más de ', suffix: ' países', label: t['proof.l4'] },
    ],
    market: { count: 5.5, decimals: 1, prefix: '$', suffix: ' mil millones', sufWord: true },
  },
}[lang];
// Logo wall. Heights are per-logo so wordmarks and stacked/icon lockups carry
// similar optical weight in the row; --logo-h feeds the CSS, which scales them
// down together on small screens.
const brands = [
  { name: 'Revlon',       src: '/logos/revlon.svg',       h: 24 },
  { name: 'Starbucks',    src: '/logos/starbucks.png',    h: 40 },
  { name: 'PepsiCo',      src: '/logos/pepsico.png',      h: 42 },
  { name: 'Kate Spade',   src: '/logos/kate-spade.svg',   h: 30 },
  { name: 'Lenox',        src: '/logos/lenox.png',        h: 38 },
  { name: 'Pyrex',        src: '/logos/pyrex.png',        h: 22 },
  { name: 'bareMinerals', src: '/logos/bareminerals.png', h: 18 },
  { name: 'Oneida',       src: '/logos/oneida.png',       h: 20 },
];


// Figures are rendered with their real value at build time rather than a literal
// "0", so they are correct before any JS runs — previously they sat at 0 until the
// bundle booted AND the element was half-visible, which is what read as "slow to load".
const nf = (v, d) => new Intl.NumberFormat(lang === 'es' ? 'es-EC' : 'en-US', { minimumFractionDigits: d, maximumFractionDigits: d }).format(v);
const numHtml = (o) =>
  (o.lead ? `<span class="lead-in">${o.lead}</span>` : '') +
  '<span class="num-line">' +
  (o.prefix ? `<span class="pre">${o.prefix}</span>` : '') +
  `<span class="val">${nf(o.count, o.decimals || 0)}</span>` +
  (o.suffix ? `<span class="suf${o.sufWord ? ' word' : ''}">${o.suffix}</span>` : '') +
  '</span>';

const steps = ['i.', 'ii.', 'iii.'];
---
<header>
  <div class="wrap navbar">
    <a class="brand" href={lang === 'es' ? '/' : '/en/'}><span class="dot"></span>Embrace <small>Ecuador</small></a>
    <div class="nav-right">
      <nav class="links">
        <a href="#services" set:html={t['nav.services']}></a>
        <a href="#opportunity" set:html={t['nav.whynow']}></a>
        <a href="#model" set:html={t['nav.model']}></a>
        <a href="#who" set:html={t['nav.who']}></a>
        <a href="#process" set:html={t['nav.process']}></a>
        <a class="btn btn-primary nav-cta" href="#contact" set:html={t['nav.cta']}></a>
      </nav>
      <div class="lang" role="group" aria-label="Language">
        <a class={'lang-btn' + (lang === 'en' ? ' active' : '')} href="/en/">EN</a>
        <a class={'lang-btn' + (lang === 'es' ? ' active' : '')} href="/">ES</a>
      </div>
    </div>
  </div>
</header>

<section class="hero" id="top">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="wrap">
    <p class="eyebrow hero-eyebrow reveal" set:html={t['hero.eyebrow']}></p>
    <h1 class="reveal" set:html={t['hero.h1']}></h1>
    <p class="lead reveal" set:html={t['hero.lead']}></p>
    <div class="hero-cta reveal">
      <a class="btn btn-primary" href="#contact"><span set:html={t['hero.cta1']}></span> <span class="arw">→</span></a>
      <a class="btn btn-ghost-dark" href="#services" set:html={t['hero.cta2']}></a>
    </div>
    <div class="proof-strip">
      {stats.proof.map((s) => (
        <div class="cell reveal">
          <div class="proof-num" data-count={s.count} data-decimals={s.decimals || 0} data-lead={s.lead || ''} data-prefix={s.prefix || ''} data-suffix={s.suffix || ""} set:html={numHtml(s)}></div>
          <div class="proof-label" set:html={s.label}></div>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="services">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow" set:html={t['wwd.eyebrow']}></p>
      <h2 set:html={t['wwd.h2']}></h2>
      <p class="lead" set:html={t['wwd.lead']}></p>
    </div>
    <div class="offers">
      <div class="offer reveal">
        <span class="tag"><i></i><span set:html={t['off1.tag']}></span></span>
        <h3 set:html={t['off1.h3']}></h3>
        <p class="sub" set:html={t['off1.sub']}></p>
        <p set:html={t['off1.p']}></p>
        <div class="spacer"></div>
        <div class="offer-cta"><a class="g" href="#contact" set:html={t['off1.cta']}></a></div>
      </div>
      <div class="offer blue reveal">
        <span class="tag"><i></i><span set:html={t['off2.tag']}></span></span>
        <h3 set:html={t['off2.h3']}></h3>
        <p class="sub" set:html={t['off2.sub']}></p>
        <p set:html={t['off2.p']}></p>
        <div class="spacer"></div>
        <div class="offer-cta"><a class="g" href="#contact" set:html={t['off2.cta']}></a></div>
      </div>
    </div>
  </div>
</section>

<section class="why" id="opportunity">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow" set:html={t['why.eyebrow']}></p>
      <h2 set:html={t['why.h2']}></h2>
    </div>
    <div class="stat-row">
      <div class="stat reveal">
        <div class="n" data-count={stats.market.count} data-decimals={stats.market.decimals || 0} data-prefix={stats.market.prefix || ''} data-suffix={stats.market.suffix || ''} data-sufword={stats.market.sufWord ? '1' : ''} set:html={numHtml(stats.market)}></div>
        <div class="d" set:html={t['why.d1']}></div>
      </div>
      <div class="stat reveal">
        <div class="n" data-count={22} data-suffix="%" set:html={numHtml({ count: 22, suffix: "%" })}></div>
        <div class="d" set:html={t['why.d2']}></div>
      </div>
      <div class="stat reveal">
        <div class="n" data-count={94} data-suffix="%" set:html={numHtml({ count: 94, suffix: "%" })}></div>
        <div class="d" set:html={t['why.d3']}></div>
      </div>
    </div>
    <div class="gap-note reveal">
      <span class="lbl" set:html={t['why.gaplbl']}></span>
      <p set:html={t['why.gapp']}></p>
    </div>
  </div>
</section>

<section class="model" id="model">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow" set:html={t['model.eyebrow']}></p>
      <h2 set:html={t['model.h2']}></h2>
      <p class="lead" set:html={t['model.lead']}></p>
    </div>
    <div class="model-diagram">
      <div class="mcard usual reveal">
        <div class="mtitle"><span class="k" set:html={t['model.c1k']}></span></div>
        <h3 set:html={t['model.c1h']}></h3>
        <p class="mdesc" set:html={t['model.c1d']}></p>
        <div class="stage">
          <div class="outside">
            <div class="ext" set:html={t['model.c1ext']}></div>
            <div class="conn" aria-hidden="true"></div>
            <div class="org" style="flex:1">
              <span class="orglbl" set:html={t['model.orglbl']}></span>
              <span class="node client" set:html={t['model.internal']}></span>
            </div>
          </div>
        </div>
      </div>
      <div class="mcard good reveal">
        <div class="mtitle"><span class="k" set:html={t['model.c2k']}></span></div>
        <h3 set:html={t['model.c2h']}></h3>
        <p class="mdesc" set:html={t['model.c2d']}></p>
        <div class="stage">
          <div class="org">
            <span class="orglbl" set:html={t['model.orglbl2']}></span>
            <span class="node client" set:html={t['model.internal2']}></span>
            <span class="node op"><i></i><span set:html={t['model.op1']}></span></span>
            <span class="node op"><i></i><span set:html={t['model.op2']}></span></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="process" id="process">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow" set:html={t['proc.eyebrow']}></p>
      <h2 set:html={t['proc.h2']}></h2>
    </div>
    <div class="steps">
      {steps.map((num, i) => (
        <div class="step reveal">
          <div class="num">{num}</div>
          <h3 set:html={t['proc.s' + (i + 1) + 'h']}></h3>
          <p set:html={t['proc.s' + (i + 1) + 'p']}></p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="who" id="who">
  <div class="wrap who-grid">
    <div class="reveal">
      <p class="eyebrow" set:html={t['who.eyebrow']}></p>
      <h2 set:html={t['who.h2']}></h2>
      <p set:html={t['who.p1']}></p>
      <p set:html={t['who.p1b']}></p>
      <p set:html={t['who.p2']}></p>
      <p set:html={t['who.p2b']}></p>
    </div>
    <div class="reveal">
      <p class="pquote" set:html={t['who.quote']}></p>
      <div class="sig">Jay Vintimilla<small set:html={t['who.sigrole']}></small></div>
      <div class="brands">
        <p class="cap" set:html={t['brands.cap']}></p>
        <div class="marks">
          {brands.map((b) => (
            <img src={b.src} alt={b.name} loading="lazy" decoding="async" style={`--logo-h:${b.h}px`} />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="selector" id="selector">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow" set:html={t['sel.eyebrow']}></p>
      <h2 set:html={t['sel.h2']}></h2>
      <p class="lead" set:html={t['sel.lead']}></p>
    </div>
    <div class="sel-toggle reveal">
      <button class="sel-opt" data-target="growth" aria-pressed="false">
        <div class="q" set:html={t['sel.o1q']}></div>
        <div class="h" set:html={t['sel.o1h']}></div>
      </button>
      <button class="sel-opt blue" data-target="savings" aria-pressed="false">
        <div class="q" set:html={t['sel.o2q']}></div>
        <div class="h" set:html={t['sel.o2h']}></div>
      </button>
    </div>
    <div class="sel-result" id="sel-result" role="status" aria-live="polite">
      <div class="rlbl" id="res-lbl">—</div>
      <h3 id="res-title">—</h3>
      <p id="res-desc">—</p>
      <a class="btn btn-primary" id="res-cta" href="#contact"><span set:html={t['sel.cta']}></span> →</a>
    </div>
  </div>
</section>

<section class="contact" id="contact">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow" set:html={t['contact.eyebrow']}></p>
      <h2 set:html={t['contact.h2']}></h2>
      <p class="lead" set:html={t['contact.lead']}></p>
    </div>
    <div class="contact-grid">
      <div class="reveal">
        <div class="path">
          <span class="pk"><i></i><span set:html={t['path1.pk']}></span></span>
          <h3 set:html={t['path1.h3']}></h3>
          <p set:html={t['path1.p']}></p>
        </div>
        <div class="path blue">
          <span class="pk"><i></i><span set:html={t['path2.pk']}></span></span>
          <h3 set:html={t['path2.h3']}></h3>
          <p set:html={t['path2.p']}></p>
        </div>
      </div>
      <div class="reveal">
        <form class="lead-form" novalidate>
          <div class="hp" aria-hidden="true"><label>Leave this field empty<input type="text" name="company_url" tabindex="-1" autocomplete="off" /></label></div>
          <div class="two">
            <div class="field"><label for="name" set:html={t['form.name']}></label><input id="name" name="name" type="text" placeholder={t['form.ph.name']} required /></div>
            <div class="field"><label for="company" set:html={t['form.company']}></label><input id="company" name="company" type="text" placeholder={t['form.ph.company']} required /></div>
          </div>
          <div class="two">
            <div class="field"><label for="email" set:html={t['form.email']}></label><input id="email" name="email" type="email" placeholder={t['form.ph.email']} required /></div>
            <div class="field">
              <label for="audit" set:html={t['form.audit']}></label>
              <select id="audit" name="audit">
                <option set:html={t['form.opt1']}></option>
                <option set:html={t['form.opt2']}></option>
                <option set:html={t['form.opt3']}></option>
              </select>
            </div>
          </div>
          <div class="field"><label for="msg" set:html={t['form.msg']}></label><textarea id="msg" name="message" rows="3" placeholder={t['form.ph.msg']}></textarea></div>
          <button class="btn btn-primary lead-submit" type="submit" style="justify-content:center"><span class="lbl" set:html={t['form.submit']}></span> <span class="arw">→</span></button>
          <p class="form-err" role="alert" hidden></p>
        </form>
        <div class="lead-conf" hidden>
          <div class="conf-check" aria-hidden="true">✓</div>
          <h3 class="conf-title">{at['conf.title']}</h3>
          <p class="conf-body">{at['conf.body']}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div>
        <div class="foot-brand"><span class="dot"></span>Embrace Ecuador</div>
        <p class="foot-tag" set:html={t['foot.tag']}></p>
      </div>
      <div class="foot-cols">
        <div class="col">
          <h4 set:html={t['foot.c1h']}></h4>
          <a href="#services" set:html={t['foot.c1a']}></a>
          <a href="#services" set:html={t['foot.c1b']}></a>
          <a href="#model" set:html={t['foot.c1c']}></a>
        </div>
        <div class="col">
          <h4 set:html={t['foot.c2h']}></h4>
          <a href="#who" set:html={t['foot.c2a']}></a>
          <a href="#process" set:html={t['foot.c2b']}></a>
          <a href="#opportunity" set:html={t['foot.c2c']}></a>
        </div>
        <div class="col">
          <h4 set:html={t['foot.c3h']}></h4>
          <a href="#contact" set:html={t['foot.c3a']}></a>
          <a href="#contact" set:html={t['foot.c3b']}></a>
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <span set:html={t['foot.copy']}></span>
      <span>Quito · Guayaquil · Ecuador</span>
    </div>
  </div>
</footer>

<script define:vars={{ locale: lang, sel: { rec: t['sel.rec'], growth: { title: t['sel.growth.title'], desc: t['sel.growth.desc'] }, savings: { title: t['sel.savings.title'], desc: t['sel.savings.desc'] } } }}>
  document.addEventListener('DOMContentLoaded', () => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fmt = (v, d) => new Intl.NumberFormat(locale === 'es' ? 'es-EC' : 'en-US', { minimumFractionDigits: d, maximumFractionDigits: d }).format(v);
    const paint = (el, val) => {
      const p = el.dataset;
      el.innerHTML = (p.lead ? '<span class="lead-in">' + p.lead + '</span>' : '')
        + '<span class="num-line">'
        + (p.prefix ? '<span class="pre">' + p.prefix + '</span>' : '')
        + '<span class="val">' + val + '</span>'
        + (p.suffix ? '<span class="suf' + (p.sufword ? ' word' : '') + '">' + p.suffix + '</span>' : '')
        + '</span>';
    };
    const animate = (el) => {
      const target = parseFloat(el.dataset.count), dec = parseInt(el.dataset.decimals || '0', 10), dur = 1400, start = performance.now();
      (function loop(now) {
        let t = Math.min((now - start) / dur, 1); t = 1 - Math.pow(1 - t, 3);
        paint(el, fmt(target * t, dec));
        if (t < 1) requestAnimationFrame(loop); else paint(el, fmt(target, dec));
      })(performance.now());
    };
    const counters = document.querySelectorAll('[data-count]');
    const reveals = document.querySelectorAll('.reveal');
    if (reduce) {
      reveals.forEach(e => e.classList.add('in'));
      // figures already carry their final value from the server — nothing to paint
    } else {
      const ro = new IntersectionObserver((es, o) => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); o.unobserve(e.target); } }), { threshold: .14, rootMargin: '0px 0px -8% 0px' });
      reveals.forEach(e => ro.observe(e));
      // Figures carry their real value from the server and are never zeroed up front,
      // so a figure is only ever wrong if the animation is actively running. Only ones
      // well below the fold are observed, with a lead margin so the count-up starts
      // off-screen. Anything at or near the fold — the hero strip on a phone — is left
      // alone entirely: a correct number beats an animated one.
      const LEAD = 260;
      const co = new IntersectionObserver((es, o) => es.forEach(e => { if (e.isIntersecting) { animate(e.target); o.unobserve(e.target); } }), { rootMargin: LEAD + 'px 0px', threshold: 0 });
      counters.forEach(el => {
        // Left at its rendered value. animate() zeroes it on its own first frame, and
        // that fires a lead margin before the figure scrolls into view, so the reset is
        // never seen. If the observer never fires at all, the correct number just stays.
        if (el.getBoundingClientRect().top > innerHeight + LEAD) co.observe(el);
      });
    }
    const box = document.getElementById('sel-result');
    const show = (target) => {
      document.getElementById('res-lbl').textContent = sel.rec;
      document.getElementById('res-title').textContent = sel[target].title;
      document.getElementById('res-desc').textContent = sel[target].desc;
      box.classList.toggle('blue', target === 'savings');
      box.classList.add('show');
    };
    document.querySelectorAll('.sel-opt').forEach(b => b.addEventListener('click', () => {
      document.querySelectorAll('.sel-opt').forEach(x => { x.classList.remove('active'); x.setAttribute('aria-pressed', 'false'); });
      b.classList.add('active'); b.setAttribute('aria-pressed', 'true'); show(b.dataset.target);
    }));
  });
</script>

<script define:vars={{ endpoint: SHEET_ENDPOINT, fallbackEmail: FALLBACK_EMAIL, locale: lang, errMsg: at['err'], sendingLabel: at['sending'] }}>
  // Mirrors the submit flow in AuditForm.astro so both forms land in the same Sheet.
  // Only locale/audit/name/company/email/message are sent; the audit form's extra
  // columns stay blank for these rows, which is what distinguishes them.
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.querySelector('form.lead-form');
    if (!form) return;
    const conf = document.querySelector('.lead-conf');
    const errEl = form.querySelector('.form-err');
    const btn = form.querySelector('.lead-submit');
    const lbl = btn.querySelector('.lbl');

    const showConfirmation = () => {
      form.hidden = true;
      conf.hidden = false;
      conf.scrollIntoView({ block: 'center', behavior: 'smooth' });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errEl.hidden = true;
      if (!form.checkValidity()) { form.reportValidity(); return; }
      // honeypot: silently accept bots without sending
      if (form.querySelector('[name="company_url"]').value) { showConfirmation(); return; }

      const fd = new FormData(form);
      fd.delete('company_url');
      const payload = { locale, submittedAt: new Date().toISOString() };
      fd.forEach((v, k) => { payload[k] = v; });

      const original = lbl.textContent;
      btn.disabled = true; lbl.textContent = sendingLabel;

      const showError = () => {
        errEl.innerHTML = errMsg + ' <a href="mailto:' + fallbackEmail + '">' + fallbackEmail + '</a>';
        errEl.hidden = false;
        btn.disabled = false; lbl.textContent = original;
      };

      if (!endpoint) { showError(); return; }
      try {
        await fetch(endpoint, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(payload) });
        showConfirmation();
      } catch (err) {
        showError();
      }
    });
  });
</script>
